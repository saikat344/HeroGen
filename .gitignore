# Everything committed here is public, including history.
# The guard (tools/guard/guard.py) blocks most of these too; this file just keeps them out of `git status`.

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
auth.json
credentials*.json
secrets/

