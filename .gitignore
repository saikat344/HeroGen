private/
raw/
*.pdf
*.mp4
*.mov
*.m4v
*.heic
*.heif
*.wav
*.m4a

# Pipeline runs and generated assets (never committed)
runs/
herogen/runs/
_cache*/
*.glb
*.gltf
*.ply
*.npz
*.blend
*.blend1
*.fbx
*.obj

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
Thumbs.db
