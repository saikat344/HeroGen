# Copy to .env (git-ignored) and fill in. Never commit real values.

# Meta Model API key (Muse Image, SAM 3.1).
MODEL_API_KEY=

# Where pipeline runs are written (git-ignored).
HEROGEN_RUNS=runs

# Blender 4.5 LTS executable, if it isn't on PATH.
BLENDER=

# SAM 3D runs on Modal. Log in with `modal setup`, then store a Hugging Face read token
# (with access to the SAM 3D checkpoints) as the Modal secret `huggingface`:
#   modal secret create huggingface HF_TOKEN=<token>
