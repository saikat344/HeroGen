# Copy to .env (git-ignored) and fill in. Never commit real values.

# Meta Model API key (Muse Image, SAM 3.1).
MODEL_API_KEY=

# Where pipeline runs are written (git-ignored).
HEROGEN_RUNS=runs

# Blender 4.5 LTS executable, if it isn't at the default macOS path or on PATH.
HEROGEN_BLENDER=

# Per-run texture-refine API cap for the hosted service (USD).
HEROGEN_SERVICE_REFINE_CAP_USD=0.80

# Optional public guest workspaces; live generation remains paused until an admin budget is verified.
HEROGEN_SERVICE_PUBLIC_DEMO=false
HEROGEN_SERVICE_MAX_RUNNING=5
# External curated public gallery pack; never point this at private run storage.
HEROGEN_SERVICE_GALLERY=

# Optional comma-separated allow-list of signed-in account emails granted /admin access (empty = nobody).
HEROGEN_SERVICE_ADMIN_EMAILS=
# Retention window in days for first-party anonymous client analytics events.
HEROGEN_SERVICE_ANALYTICS_RETENTION_DAYS=30
