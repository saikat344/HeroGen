#!/bin/sh
# Finds a Python 3 interpreter (macOS, Linux, or Git for Windows' bundled sh) and runs the guard.
# Refuses to continue without one: a missing interpreter must never mean a skipped check.
root="$(git rev-parse --show-toplevel)" || exit 1
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then
    exec "$py" "$root/tools/guard/guard.py" "$@"
  fi
done
echo "guard: no Python 3.8+ found; refusing to continue without checks." >&2
exit 1
